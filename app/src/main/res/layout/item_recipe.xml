<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#F0EDE8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGE avec badges -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="110dp">

            <ImageView
                android:id="@+id/imgRecipeItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#F2F0EB" />

            <!-- Badge difficulté (haut gauche) -->
            <TextView
                android:id="@+id/tvDifficultyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_gravity="top|start"
                android:background="@drawable/bg_badge_green"
                android:text="Facile"
                android:textColor="#0F6E56"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Badge temps (haut droite) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_dark"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#FF6B35" />

                <TextView
                    android:id="@+id/tvTimeItem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="25 min"
                    android:textColor="#FAFAF7"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

        </FrameLayout>

        <!-- BODY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTitleItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="#0D0D0D"
                android:layout_marginBottom="3dp" />

            <TextView
                android:id="@+id/tvDescriptionItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#9A9A9A"
                android:fontFamily="sans-serif-light"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="10dp" />

            <!-- Tags meta -->
            <LinearLayout
                android:id="@+id/metaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">



                <TextView
                    android:id="@+id/tvPortionsTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_meta_tag"
                    android:text="4 pers."
                    android:textColor="#6A6A6A"
                    android:textSize="10sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

            </LinearLayout>

            <!-- Séparateur -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F2F0EB"
                android:layout_marginBottom="10dp" />

            <!-- ACTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Modifier -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditItem"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:text="Modifier"
                    android:textSize="11sp"
                    android:backgroundTint="#F2F0EB"
                    android:textColor="#0D0D0D"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="#0D0D0D"
                    app:iconSize="12dp"
                    app:iconPadding="4dp" />

                <!-- Supprimer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteItem"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:backgroundTint="#FFF0ED"
                    app:cornerRadius="10dp"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_trash"
                    app:iconTint="#D85A30"
                    app:iconSize="13dp"
                    app:iconPadding="0dp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>